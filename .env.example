# .env.prod 템플릿 (커밋용) — cp .env.example .env.prod 후 CHANGE_ME 교체
APP_ENV=prod
BIND_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
DB_ENGINE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app

# AegisMesh — 증적 원장 서명키(base64 Ed25519 32바이트, KMS/Secret Manager 주입). CHANGE_ME 면 데이터 볼륨에 생성(리허설 전용)
AUTO_MIGRATE=false
LEDGER_SIGNING_KEY=CHANGE_ME
LEDGER_CHECKPOINT_EVERY=100
WORKER_INTERVAL_SEC=30
REGISTRY_DIR=/app/data/registry
REVIEW_CPU_SEC=20
EVIDENCE_RETENTION_DAYS=90
MODEL_EGRESS=deny
OTEL_ENDPOINT=https://otel-collector:4318
# allow 판정 추적 표본 비율(비허용·강등·예산 초과는 항상, 지표는 전부) — 노드당 수천 rps 에서 span 비용을 줄인다(Epic 66)
OTEL_ALLOW_TRACE_RATIO=0.1
GOVERNANCE_INTERVAL_SEC=3600
REDTEAM_INTERVAL_SEC=86400
AUTH_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BACKCHANNEL_MAP=
WEB_CONCURRENCY=2
DB_MAX_CONNECTIONS=300
IDP_PORT=8080
BAO_PORT=8210
TENANCY_TEST_INTERVAL_SEC=86400
OTEL_DEBUG_VERBOSITY=basic
SPIFFE_TRUST_DOMAIN=aegismesh.local
SVID_TTL_SEC=3600
SVID_SIGNING_KEY=
SECRET_LEASE_MAX_SEC=900
SECRETS_BACKEND=builtin
OPENBAO_ADDR=http://bao:8200
OPENBAO_TOKEN=
# OpenBao 운영형 클러스터 상호 TLS(Epic 56) — make bao-cluster-up 이 infra/openbao/cluster-api.env 로 넣는다(주소 3개·CA·클라이언트 인증서)
OPENBAO_CA_FILE=
OPENBAO_CLIENT_CERT=
OPENBAO_CLIENT_KEY=
CORPORA_DIR=/corpora
CORPUS_INTERVAL_SEC=604800
SANDBOX_L1_SLOTS=4
SANDBOX_QUEUE_SEC=2
SANDBOX_RECYCLE_USES=200
SANDBOX_CALL_TIMEOUT_SEC=2
SANDBOX_CPU_SEC=60
EVIDENCE_ASYNC=true
EVIDENCE_QUEUE_MAX=20000
EVIDENCE_SAMPLE_EVERY=10
EVIDENCE_BATCH_MAX=500
HOT_CACHE_TTL_SEC=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# 재해 복구 (NFR-A5) — 복제 역할 비밀번호 · WAL 보관 주기(일반 데이터 RPO 상한, 초) · 기본 백업 주기(초)·보관 개수 — 주기는 'WAL 재생 시간 < RTO' 로 정한다(실측 최대 WAL 7 MB/s·재생 65 MB/s → 4시간)
DB_REPLICATION_PASSWORD=CHANGE_ME
DB_ARCHIVE_TIMEOUT_SEC=60
DB_BACKUP_INTERVAL_SEC=14400
DB_BACKUP_KEEP=12
# 내부 상호 TLS 인증서 디렉터리 (NFR-D3) — prod compose 가 볼륨 tls 의 api 하위 경로를 붙인다. 비우면 평문
TLS_DIR=/tls
# 저장 암호화 KMS (NFR-D2) — builtin(데이터 디렉터리 키 고리, 비커밋) | openbao(transit 키 KMS_TRANSIT_KEY — 영속 OpenBao 에서만: dev 서버는 재기동 때 키를 잃는다)
KMS_BACKEND=builtin
KMS_TRANSIT_KEY=aegis-kek
# D1-03 깊은 검사 (Epic 50) — 안전 분류 모델 서버 주소(make guard-up 이 infra/guard/api.env 로 넣는다) · 위험 확률 하한 · 대기 상한 · 모델 스레드
GUARD_URL=
GUARD_UNSAFE_MIN=0.5
GUARD_QUEUE_MAX=200
GUARD_THREADS=8
# 깊은 검사 경보 → 같은 주체·세션 격리 기한(초, 0 = 경보만) — Epic 51
GUARD_QUARANTINE_SEC=3600
# 백업 외부 복사 (Epic 52, prod) — S3 호환 객체 저장(SeaweedFS) 주소·버킷·자격 증명 · 복사 주기(초)
S3_ENDPOINT=https://objstore:8333
S3_BUCKET=aegis-backup
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
OFFSITE_INTERVAL_SEC=60
# 워크로드 신원 발급처 (Epic 53) — builtin(내장 Ed25519) | spire(make spire-up 이 infra/spire/api.env 로 넣는다)
IDENTITY_BACKEND=builtin
# 지오 IP(Epic 55, DB-IP Lite 이미지 고정 판) — 같은 나라 SAME_PLACE_KM 안 = 같은 위치, 거리 ≥ MIN_KM 이고 속도 > MAX_KMH = 불가능한 이동(재인증·D5-03 경보)
GEO_SAME_PLACE_KM=100
GEO_TRAVEL_MAX_KMH=900
GEO_TRAVEL_MIN_KM=500
# 이미지 빌드 — FIDO MDS3 받기 실패(요청 제한 등) 때만 1: 스냅숏 없이 빌드(허용목록 테넌트 보안 키 등록은 닫힌 실패). 검증 실패는 항상 빌드 실패 (Epic 54)
FIDO_MDS_OPTIONAL=0
# 원장 저장 재암호화 창 수명(초, Epic 57) — 2인 승인 뒤 이 시간 안에만 DB 트리거가 평문→암호문 갱신을 허용
LEDGER_REWRAP_WINDOW_SEC=21600
# 발견 버스(Epic 60) — make bus-up 이 infra/nats/api.env 로 BUS_URL 을 넣는다. 첫 기동 커서 head(지금부터)|all(원장 처음부터)
BUS_URL=
# 인라인 주입 분류 모델(Epic 64) — make injguard-up 이 INJGUARD_URL 을 넣는다. 입력 앞·뒤 창(토큰)·예산(ms)·경보/차단 임계
INJGUARD_WINDOW=96
INJGUARD_TIMEOUT_MS=60
INJGUARD_ALERT=0.95
INJGUARD_BLOCK=0.999
BUS_START=head
BUS_MAX_AGE_DAYS=7
FP_BUDGET_MIN=2
FP_RECOVER_DAYS=7
FAIRNESS_INTERVAL_SEC=604800
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
WEB_SESSION_SECRET=
APPROVAL_TTL_MIN=240
QUALITY_CHECK_INTERVAL_SEC=300
GOLDEN_INTERVAL_SEC=604800
# 에이전트 기본 엔진 바꾸기 "agent=engine,…" — make injguard-up 이 infra/injguard/api.env 로 d1-03=injection_model 을 넣는다(Epic 64)
ENGINE_OVERRIDES=
# L2 격리 브로커(gVisor, compose sandbox-l2) 주소 — make l2-up 이 infra/gvisor/api.env 로 넣는다. 비면 L2 없음(Epic 65)
SANDBOX_L2_URL=
SANDBOX_L2_SLOTS=4
